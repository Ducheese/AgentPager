<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>AgentPager.Bridge.Program</StartupObject>
    <AssemblyName>AgentPagerBridge</AssemblyName>
    <RootNamespace>AgentPager.Bridge</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!--
      本机发布默认走框架依赖：单文件自包含包有 223MB，每次打开设置都要先加载它，
      冷启动和二次启动都显得笨重；框架依赖的 exe 只有 149KB、整个目录约 35MB
      （大头是 Windows SDK 投影 DLL），要求机器已装 .NET 8 Desktop Runtime 与
      ASP.NET Core Runtime（本机 SDK 已包含）。
      对外安装包由 scripts\package-windows.ps1 显式传 self-contained=true 与
      PublishSingleFile=true，仍然自带 .NET，不改变最终用户的安装体验。
    -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AgentPager.Bridge.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgentPager.Core\AgentPager.Core.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="QRCoder" />
    <Resource Include="..\..\..\assets\brand\agentpager-icon.png" Link="Assets\agentpager-icon.png" />
    <Resource Include="..\..\..\assets\fonts\fusion_pixel_12px_zh_hans.ttf" Link="Assets\fusion_pixel_12px_zh_hans.ttf" />
  </ItemGroup>
</Project>
